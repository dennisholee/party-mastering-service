{
  "version": "1.0",
  "rules": [
    {
      "id": "party.dateOfBirth.format",
      "resourceType": "party",
      "field": "dateOfBirth",
      "op": "pattern",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "blocking": true
    },
    {
      "id": "party.contactPoints.email.format",
      "resourceType": "party",
      "field": "contactPoints.email.value",
      "op": "pattern",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[A-Za-z]{2,}$",
      "blocking": true
    },
    {
      "id": "party.contactPoints.phone.format",
      "resourceType": "party",
      "field": "contactPoints.phone.value",
      "op": "pattern",
      "pattern": "^\\+?[0-9][0-9-]{6,19}$",
      "blocking": true
    },
    {
      "id": "party.segment.allowed",
      "resourceType": "party",
      "field": "segment",
      "op": "pattern",
      "pattern": "^(RETAIL|PREMIER|PRIVATE)$",
      "blocking": true
    },
    {
      "id": "party.version.type",
      "resourceType": "party",
      "field": "version",
      "op": "type",
      "value": "number",
      "blocking": true
    },
    {
      "id": "party.changeReason.format",
      "resourceType": "party",
      "field": "changeReason",
      "op": "pattern",
      "pattern": "^[A-Z_]{3,32}$",
      "blocking": true
    },
    {
      "id": "party.legalName.middleName.length",
      "resourceType": "party",
      "field": "legalName.middleName",
      "op": "maxLength",
      "maxLength": 40,
      "blocking": false
    },
    {
      "id": "party.merge.sourcePartyId.format",
      "resourceType": "partyMerge",
      "field": "sourcePartyId",
      "op": "pattern",
      "pattern": "^PTY-[0-9]{4,}$",
      "blocking": true
    },
    {
      "id": "party.merge.reason.format",
      "resourceType": "partyMerge",
      "field": "reason",
      "op": "pattern",
      "pattern": "^[A-Z_]{3,32}$",
      "blocking": true
    }
  ]
}
